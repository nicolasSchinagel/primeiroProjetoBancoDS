<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Joalheira Duquesa - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/projetoBancoDS.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="d-flex justify-content-center align-items-center tamanho-nav-bar">
        <nav class="bg-pink tamanho-nav-bar d-flex w-100 align-items-center justify-content-center " >
            <div class="d-flex flex-column align-items-center justify-content-center w-100">
                <img src="~/img/logoDuquesa.png" class="img-logo"/>
                <h2 onclick="hiddenChanges()" class="text-white position-absolute from-down-little cursor user-select-none">...</h2>
                <div class="w-50 h-50px flex-row position-absolute bg-pink from-down border-high" id="divThatHiddens">
                    <ul class="d-flex flex-row gap-5 w-100 h-100 justify-content-around align-items-center px-5 without-in-list">
                        <li class="">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="">
                            <a class="nav-link text-white" asp-area="" asp-controller="Account" asp-action="Cadastroproduto">Cadastro do Produto</a>
                        </li>
                        <li class="">
                            <a class="nav-link text-white" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                    </ul>
       
                </div>
                
            </div>
        </nav>
    </header>
    <!--Na class da div main poderia ter container, mas tirei por que muitos items quero que ocupe espaço total-->
    <div class="">
        <main role="main" class="">
            @RenderBody()
        </main>
    </div>

    <footer class="h-mini bg-pink d-flex align-items-center">
        <div class="">
            <h4 class="text-white">&copy; 2025 - Joalheria Duquesa</h4>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        let divHidden = document.querySelector('#divThatHiddens');
        divHidden.style.display = 'flex';
        function hiddenChanges(){
            if(divHidden.style.display != 'none'){
                divHidden.style.display = 'none';
                console.log("mudando para none");
            }
            else{
                divHidden.style.display = 'flex';
                console.log("mudando para flex");
            }
        }
    </script>
</body>
</html>
