@model projetoBancoDS.Models.LoginPF;
@{
	ViewData["title"] = "Login do ClientePF";
}

<section class="d-flex flex-column align-items-center p-150 bg-white w-100 h-auto gap-3">
	<form asp-action="LogCliPF" method="post" class="d-flex flex-column gap-3 align-items-center">
		<h3 class="font-bahnschrift-condensed fw-light">Login do Cliente de CPF</h3>
		<div class="text-danger" asp-validation-summary="ModelOnly"></div>
		<div class="form-group">
			<label class="control-label" asp-for="NomeCliente"></label>
			<input class="form-control" asp-for="NomeCliente" />
			<span class="text-danger" asp-validation-for="NomeCliente"></span>
		</div>

		<div class="form-group">
			<label class="control-label" asp-for="CPF"></label>
			<input class="form-control" asp-for="CPF" />
			<span class="text-danger" asp-validation-for="CPF"></span>
		</div>
		<div class="form-group">
			<input type="submit" value="Fazer Login" class="btn btn-primary" />
		</div>
	</form>
</section>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
@if (TempData["Error"] != null)
{
	<script>alert('@TempData["Error"]');</script>
}